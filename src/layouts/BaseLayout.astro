---
import { t } from "../i18n";
import {
  siteInfo,
  personalInfo,
  welcomeConfig,
} from "../config";
import { withBase } from "../lib/url";
import "../styles/global.css";
import "@fontsource-variable/noto-sans";
import "@fontsource-variable/noto-sans-jp";
import "@fontsource-variable/noto-sans-sc";
import "@fontsource-variable/jetbrains-mono";
import Navigation from "../components/header/Navigation.vue";
import Welcome from "../components/header/Welcome.astro";
import Search from "../components/header/Search.vue";
import MainContainer from "../components/MainContainer.vue";
import { getPosts, summarize } from "../lib/posts";
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  heroTitle?: string;
  heroSubtitle?: string;
  home?: boolean;
  article?: boolean;
  publishedTime?: string;
  noindex?: boolean;
}
const {
  title,
  description = siteInfo.description,
  ogImage,
  heroTitle,
  heroSubtitle,
  home = false,
  article = false,
  publishedTime,
  noindex = false,
} = Astro.props;
const posts = (await getPosts()).map(summarize);
const pageTitle = title
  ? `${title} · ${siteInfo.title}`
  : `${siteInfo.title} · ${siteInfo.titleSuffix}`;
const canonical = new URL(Astro.url.pathname, siteInfo.url);
// Root-English move (2026-11-19): single-language site — no hreflang
// tags and no language switcher. <html lang> is "en" (see below).
const ogImageUrl = new URL(ogImage ?? welcomeConfig.bgImage, siteInfo.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={siteInfo.favicon} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="keywords" content={siteInfo.keywords.join(", ")} />
    <meta name="author" content={personalInfo.name} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteInfo.title} />
    <meta property="og:locale" content={siteInfo.locale} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    {article && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteInfo.title} RSS`}
      href={withBase("/rss.xml")}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem("theme");
        } catch {}
        document.documentElement.classList.toggle(
          "dark",
          theme === "dark" ||
            (theme !== "light" &&
              matchMedia("(prefers-color-scheme: dark)").matches),
        );
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {t("common.skip")}
    </a>
    <Navigation pathname={Astro.url.pathname} client:load />
    <Search posts={posts} client:load />
    <Welcome
      compact={!home}
      title={heroTitle}
      subtitle={heroSubtitle}
      headingLevel={article ? 2 : 1}
    />
    <MainContainer>
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
    </MainContainer>
    <footer class="site-footer">
      <a href={withBase("/")} class="footer-mark">
        <span class="accent">✿</span> {siteInfo.title}.
      </a>
      <p>{t("footer.message")}</p>
      <p>
        © {new Date().getFullYear()} {personalInfo.englishName} ·{" "}
        <a href={withBase("/rss.xml")}>{t("common.rss")}</a> ·{" "}
        <a href={withBase("/about/")}>{t("common.aboutSite")}</a> ·{" "}
        <a href={withBase("/privacy/")}>{t("common.privacy")}</a> ·{" "}
        <a href={withBase("/terms/")}>{t("common.terms")}</a> ·{" "}
        <a href={withBase("/contact/")}>{t("common.contact")}</a>
      </p>
    </footer>
    <button
      class="back-top"
      id="back-top"
      aria-label={t("common.backTop")}
      hidden
    >
      <span class="icon-[lucide--arrow-up]"></span>
    </button>
    <script>
      const button = document.querySelector<HTMLButtonElement>("#back-top");
      const update = () => {
        if (button) button.hidden = window.scrollY < 500;
      };
      window.addEventListener("scroll", update, { passive: true });
      button?.addEventListener("click", () =>
        window.scrollTo({
          top: 0,
          behavior: matchMedia("(prefers-reduced-motion: reduce)").matches
            ? "instant"
            : "smooth",
        }),
      );
      update();
    </script>
  </body>
</html>

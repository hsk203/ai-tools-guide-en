---
import { t } from "../../i18n";
import { welcomeConfig } from "../../config";
import Waves from "./Waves.vue";
interface Props {
  compact?: boolean;
  title?: string;
  subtitle?: string;
  headingLevel?: 1 | 2;
}
const { compact = false, title, subtitle, headingLevel = 1 } = Astro.props;
const Heading = headingLevel === 1 ? "h1" : "h2";
---

<section
  class:list={["welcome-section", { compact }]}
  style={`background-image: url('${welcomeConfig.bgImage}'); --hero-position: ${welcomeConfig.imagePosition}; --hero-overlay: ${welcomeConfig.overlayOpacity};`}
  aria-label={title || welcomeConfig.title}
>
  <div class="hero-shade"></div>
  <div class="hero-content">
    <span class="hero-eyebrow">
      {compact ? t("hero.pageEyebrow") : t("hero.homeEyebrow")}
    </span>
    <Heading class="hero-title">
      {title || welcomeConfig.title}
      <span class="hero-sparkle" aria-hidden="true">
        ✧
      </span>
    </Heading>
    <p>{subtitle || welcomeConfig.subTitle}</p>
    {!compact && (
      <a href="#main-content" class="hero-explore">
        {t("hero.explore")}{" "}
        <span class="icon-[lucide--arrow-down]" aria-hidden="true"></span>
      </a>
    )}
  </div>
  <span class="hero-side-note" aria-hidden="true">
    {t("hero.sideNote")}
  </span>
  <Waves class="hero-waves" />
</section>
<style>
  .welcome-section {
    position: relative;
    height: 360px;
    background-size: cover;
    background-position: var(--hero-position, center 47%);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
    overflow: hidden;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(
        ellipse at 80% 22%,
        color-mix(in srgb, var(--accent-2) 34%, transparent),
        transparent 38%
      ),
      radial-gradient(
        ellipse at 18% 14%,
        color-mix(in srgb, var(--accent) 28%, transparent),
        transparent 42%
      ),
      linear-gradient(
        108deg,
        rgb(8 15 39 / var(--hero-overlay, 0.38)) 0%,
        rgb(25 20 61 / calc(var(--hero-overlay, 0.38) * 0.78)) 52%,
        rgb(7 27 41 / calc(var(--hero-overlay, 0.38) * 0.86)) 100%
      );
  }
  .welcome-section::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0.14;
    background-image:
      linear-gradient(#ffffff12 1px, transparent 1px),
      linear-gradient(90deg, #ffffff12 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(
      90deg,
      transparent,
      black 46%,
      black 82%,
      transparent
    );
  }
  .hero-content {
    position: relative;
    z-index: 3;
    padding: 25px 20px 55px;
    text-shadow: 0 2px 18px rgb(17 10 28 / 48%);
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    padding: 7px 13px;
    border: 1px solid #ffffff3b;
    border-radius: 999px;
    background: #ffffff12;
    backdrop-filter: blur(10px);
    font-family: "Oxanium-Medium", var(--font-body);
    font-size: 11px;
    letter-spacing: 0.16em;
    opacity: 0.98;
    margin-bottom: 18px;
  }
  .hero-content .hero-title {
    margin: 0 0 10px;
    font-size: clamp(30px, 3.5vw, 46px);
    letter-spacing: 0.01em;
    font-weight: 700;
    line-height: 1.28;
    text-shadow: 0 6px 28px rgb(17 10 28 / 64%);
  }
  .hero-sparkle {
    display: inline-block;
    font-size: 33px;
    margin-left: 12px;
    vertical-align: top;
    color: var(--accent-2);
    text-shadow: 0 0 24px color-mix(in srgb, var(--accent-2) 52%, transparent);
  }
  .hero-content p {
    font-size: 15px;
    letter-spacing: 0.08em;
    margin: 8px auto 23px;
    max-width: 68ch;
    line-height: 1.7;
  }
  .hero-explore {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    border: 1px solid #ffffff75;
    background: #ffffff18;
    padding: 8px 18px;
    border-radius: 30px;
    font-size: 11px;
    letter-spacing: 0.05em;
    backdrop-filter: blur(12px);
    box-shadow: 0 10px 30px rgb(17 10 28 / 28%);
  }
  .hero-explore:hover {
    background: #ffffff2e;
    transform: translateY(-2px);
  }
  .hero-side-note {
    position: absolute;
    right: 26px;
    top: 42%;
    writing-mode: vertical-rl;
    font-family: "Oxanium-Medium", var(--font-body);
    font-size: 9px;
    letter-spacing: 0.22em;
    opacity: 0.65;
  }
  .hero-waves {
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    z-index: 2;
  }
  .hero-waves svg {
    height: 70px;
    min-height: 70px;
  }
  .welcome-section.compact {
    height: 250px;
  }
  .compact .hero-content {
    padding-top: 72px;
  }
  .compact .hero-content .hero-title {
    font-size: 34px;
  }
  .compact .hero-eyebrow {
    font-size: 10px;
    margin-bottom: 10px;
  }
  .compact .hero-content p {
    font-size: 13px;
  }
  @media (max-width: 760px) {
    .welcome-section {
      height: 320px;
      background-position: 50% 52%;
    }
    .hero-content {
      padding-top: 50px;
    }
    .hero-content p {
      font-size: 13px;
      letter-spacing: 0.02em;
      line-height: 1.65;
    }
    .hero-eyebrow {
      font-size: 10px;
      letter-spacing: 0.12em;
      margin-bottom: 12px;
    }
    .hero-content .hero-title {
      font-size: 29px;
      line-height: 1.35;
    }
    .hero-sparkle {
      font-size: 24px;
      margin-left: 5px;
    }
    .hero-side-note {
      display: none;
    }
    .welcome-section.compact {
      height: 228px;
    }
    .compact .hero-content .hero-title {
      font-size: 28px;
    }
  }
</style>

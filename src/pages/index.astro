---
import { t } from "../i18n";
import BlogLayout from "../layouts/BlogLayout.astro";
import PostFeed from "../components/posts/PostFeed.vue";
import PostListFallback from "../components/posts/PostListFallback.astro";
import { getPosts, summarize } from "../lib/posts";
import { categoryNames, categoryLabel } from "../data/post-options";
import { withBase } from "../lib/url";
const posts = (await getPosts()).map(summarize);
const counts = new Map(
  categoryNames.map((c) => [c, posts.filter((p) => p.category === c).length]),
);
---

<BlogLayout home>
  <div class="hello-strip">
    <span class="icon-[lucide--sparkles]" aria-hidden="true"></span>
    <p>{t("home.greeting")}</p>
    <span class="hello-pill">{t("home.greetingBadge")}</span>
  </div>
  <section class="tool-categories" aria-label={t("home.categoriesTitle")}>
    <div class="categories-head">
      <h2>{t("home.categoriesTitle")}</h2>
      <p>{t("home.categoriesSubtitle")}</p>
    </div>
    <div class="category-grid">
      {categoryNames.map((c) => (
        <a
          class="category-card"
          href={withBase(`/?category=${encodeURIComponent(c)}`)}
        >
          <strong>{categoryLabel(c)}</strong>
          <span>{t("post.records", { count: counts.get(c) ?? 0 })}</span>
        </a>
      ))}
    </div>
  </section>
  <PostFeed posts={posts} client:load />
  <PostListFallback posts={posts} />
  <p class="impact-verification" aria-hidden="true">
    Impact-Site-Verification: debcc67c-f25b-4c06-930a-8f3ea9e19919
  </p>
  <p class="impact-verification" aria-hidden="true">
    Impact-Site-Verification: 5ca0ccb5-e829-4b08-8ace-8b736ae24b3d
  </p>
</BlogLayout>
<style>
  .hello-strip {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--text);
    font-size: 12px;
    font-weight: 600;
    margin: 0 0 21px;
    padding: 13px 17px;
    border: 1px solid color-mix(in srgb, var(--accent) 24%, var(--line));
    border-left: 4px solid var(--accent);
    border-radius: 14px;
    background: linear-gradient(
      100deg,
      color-mix(in srgb, var(--accent-soft) 82%, var(--card)),
      color-mix(in srgb, var(--accent-2) 10%, var(--card))
    );
    box-shadow: 0 8px 24px color-mix(in srgb, var(--accent) 7%, transparent);
  }
  .hello-strip > span:first-child {
    font-size: 17px;
    flex-shrink: 0;
    color: var(--accent);
  }
  .hello-strip p {
    margin: 0;
    flex: 1;
  }
  .hello-pill {
    font:
      9px "Oxanium-Medium",
      var(--font-body);
    letter-spacing: 0.12em;
    color: var(--accent-2);
  }
  .tool-categories {
    margin: 0 0 26px;
  }
  .categories-head h2 {
    font-size: 19px;
    letter-spacing: -0.02em;
    margin: 0 0 4px;
  }
  .categories-head p {
    font-size: 12px;
    color: var(--muted);
    margin: 0 0 16px;
  }
  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
  }
  .category-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 17px 18px;
    border: 1px solid color-mix(in srgb, var(--category-color) 22%, var(--line));
    border-top: 3px solid var(--category-color);
    border-radius: 16px;
    background: linear-gradient(
      145deg,
      color-mix(in srgb, var(--category-wash) 68%, var(--card)),
      var(--card) 76%
    );
    box-shadow: 0 10px 28px
      color-mix(in srgb, var(--category-color) 8%, transparent);
    color: var(--text);
    text-decoration: none;
    transition:
      transform 0.2s,
      box-shadow 0.2s,
      border-color 0.2s,
      background 0.2s;
  }
  .category-card:nth-child(4n + 1) {
    --category-color: #4f5ff4;
    --category-wash: #dfe4ff;
  }
  .category-card:nth-child(4n + 2) {
    --category-color: #08a89d;
    --category-wash: #d8f5ef;
  }
  .category-card:nth-child(4n + 3) {
    --category-color: #eb7c63;
    --category-wash: #ffebe4;
  }
  .category-card:nth-child(4n + 4) {
    --category-color: #945be5;
    --category-wash: #f0e5ff;
  }
  .category-card::after {
    content: "";
    position: absolute;
    z-index: -1;
    width: 86px;
    height: 86px;
    right: -35px;
    top: -47px;
    border: 1px solid color-mix(in srgb, var(--category-color) 18%, transparent);
    border-radius: 50%;
    box-shadow: 0 0 0 13px
      color-mix(in srgb, var(--category-color) 5%, transparent);
    transition: transform 0.25s;
  }
  .category-card:hover {
    border-color: color-mix(in srgb, var(--category-color) 60%, var(--line));
    border-top-color: var(--category-color);
    transform: translateY(-4px);
    box-shadow: 0 16px 32px
      color-mix(in srgb, var(--category-color) 18%, transparent);
  }
  .category-card:hover::after {
    transform: scale(1.12);
  }
  .category-card strong {
    color: var(--category-color);
    font-size: 15px;
    font-weight: 600;
  }
  .category-card span {
    font-size: 11px;
    color: var(--muted);
  }
  :global(.dark) .category-card:nth-child(4n + 1) {
    --category-wash: #29345e;
  }
  :global(.dark) .category-card:nth-child(4n + 2) {
    --category-wash: #183f43;
  }
  :global(.dark) .category-card:nth-child(4n + 3) {
    --category-wash: #4a302f;
  }
  :global(.dark) .category-card:nth-child(4n + 4) {
    --category-wash: #382c51;
    --category-color: #c39cff;
  }
  :global(.dark) .category-card:nth-child(4n + 1) {
    --category-color: #aab3ff;
  }
  :global(.dark) .category-card:nth-child(4n + 2) {
    --category-color: #69e4d4;
  }
  :global(.dark) .category-card:nth-child(4n + 3) {
    --category-color: #ffad8e;
  }
  @media (max-width: 760px) {
    .hello-strip {
      font-size: 10px;
      margin-bottom: 22px;
    }
    .category-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .hello-pill {
      display: none;
    }
  }
  .impact-verification {
    display: none;
  }
</style>

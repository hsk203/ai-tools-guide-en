---
import { t } from "../i18n";
import BlogLayout from "../layouts/BlogLayout.astro";
import { personalInfo } from "../config";
---

<BlogLayout
  title={t("contact.title")}
  heroTitle={t("contact.title")}
  heroSubtitle={t("contact.updated")}
>
  <section class="card page-card">
    <div class="prose">
      <p>{t("contact.intro")}</p>
      <h2>{t("contact.emailTitle")}</h2>
      <p>{t("contact.emailBody")}</p>
      <p>
        <a class="btn" href="mailto:hsk203@gmail.com">hsk203@gmail.com</a>
      </p>
      <h2>{t("contact.topicsTitle")}</h2>
      <p>{t("contact.topicsBody")}</p>
      <h2>{t("contact.responseTitle")}</h2>
      <p>{t("contact.responseBody")}</p>
      <h2>{t("contact.githubTitle")}</h2>
      <p>{t("contact.githubBody")}</p>
      <p>
        <a
          class="btn secondary"
          href={personalInfo.github}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="icon-[jam--github]" aria-hidden="true"></span>GitHub
        </a>
      </p>
    </div>
  </section>
</BlogLayout>
